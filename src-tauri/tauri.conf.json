{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shellmosaic",
  "version": "0.4.1",
  "identifier": "com.shellmosaic.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: smbg: http://smbg.localhost",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "smplugin: http://smplugin.localhost"
      },
      "devCsp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzODMzNDI5NTcxRjhFRDEKUldUUmpoOVhLVFNEQTNWNWR3WnZpbUxZR0ZabnpySnU5QmhIRWtidjFzWUttdzVVdDhvc0NDUmkK",
      "endpoints": ["https://github.com/VinZie/shellmosaic/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Modular workspace terminal",
    "longDescription": "Shellmosaic is a workspace-based terminal for Windows with tiling panes, modules and plugins.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
